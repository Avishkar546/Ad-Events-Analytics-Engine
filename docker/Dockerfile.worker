# Worker service Dockerfile — runs the hourly aggregation job via
# APScheduler (app/workers/aggregation_job.py). Separate image from the API
# on purpose: the API needs to handle request bursts, the worker just needs
# to run once an hour — they scale independently in a real deployment.
FROM python:3.12-slim

WORKDIR /code

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY app ./app

CMD ["python", "-m", "app.workers.aggregation_job"]
