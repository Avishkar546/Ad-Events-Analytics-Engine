# Worker service Dockerfile — placeholder for v0.5, when the aggregation
# job is implemented. Kept separate from Dockerfile.api because the API
# and worker scale independently in a real deployment (see implementation
# plan, section 2). Not used until docker-compose wires it up in v0.5.
FROM python:3.12-slim

WORKDIR /code

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY app ./app

CMD ["echo", "worker not yet implemented — see v0.5"]
