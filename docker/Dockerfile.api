FROM python:3.12-slim

WORKDIR /code

# Install deps first so this layer caches even when app code changes
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY app ./app

EXPOSE 8000

# --host 0.0.0.0 is required for the container's port to be reachable
# from outside — 127.0.0.1 would only be reachable inside the container.
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
